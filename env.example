# Template - copier ce fichier en .env (jamais commit) et remplir avec tes vraies valeurs.
# Le .env est exclu via .gitignore.

# ===========================================================================
# HuggingFace - pour push les 3 Spaces (mlflow-server + dashboard + api)
# ===========================================================================
# Generer un token avec scope "Write" sur https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxx

# Username HF (pour creer les Spaces sous ton compte)
HF_USERNAME=Alh92500

# ===========================================================================
# MLflow tracking
# ===========================================================================
# Une fois le Space mlflow-server deploye, decommente la ligne ci-dessous.
# Tant qu'elle est commentee, le training et l'API utilisent le file backend local (./mlruns/).
# MLFLOW_TRACKING_URI=https://alh92500-getaround-mlflow.hf.space

# Run ID du modele a charger dans l'API (genere par notebooks/01_train_pricing.py).
# Lu depuis api/.last_run_id par defaut si non defini.
# MLFLOW_RUN_ID=

# ===========================================================================
# AWS (optionnel - uniquement pour Setup B avec artefacts S3 persistants)
# ===========================================================================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-west-3
